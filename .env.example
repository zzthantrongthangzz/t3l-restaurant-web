
# Spring Boot connects to the host ports published by docker compose.
MYSQL_URL=jdbc:mysql://localhost:3307/t3l_restaurant?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Ho_Chi_Minh
MYSQL_USER=t3l_app
MYSQL_PASSWORD=change-this-db-password
MYSQL_DATABASE=t3l_restaurant
MYSQL_ROOT_PASSWORD=change-this-root-password
MONGODB_URI=mongodb://localhost:27018/t3l_restaurant

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
# docker compose --profile atlas-local up -d mongodb-vector
CHAT_VECTOR_MONGODB_URI=mongodb://127.0.0.1:27019/t3l_restaurant?directConnection=true
CHAT_GEMINI_TIMEOUT_SECONDS=6
CHAT_GEMINI_CALLS_PER_DAY=250
CHAT_REQUESTS_PER_MINUTE=8

APP_STAFF_USERNAME=staff
APP_STAFF_PASSWORD=Staff@123
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=Admin@123
APP_ADMIN_NAME=Restaurant Administrator
# Dev-only sample key; replace it with a private random key before sharing/deployment.
APP_JWT_SECRET=VDNMLUxPQ0FMLURFVi1PTkxZLUNIQU5HRS1USElTLUJFRk9SRS1TSEFSSU5HLTAxMjM0NTY3ODk=
APP_JWT_EXPIRATION_MS=86400000
TRACKING_ENABLED=true
# Google OAuth (optional). Redirect URI for local development: http://localhost:8085/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=
# Use the approved SMS template and mark the code position with {otp}.
ESMS_OTP_TEMPLATE=
# Local mode requires a loopback bind, for example SERVER_ADDRESS=127.0.0.1.
SMS_OTP_LOCAL_ENABLED=false
SMS_OTP_LOCAL_PHONE=0900000000
# Gmail SMTP for reservation emails. Use a Gmail App Password.
MAIL_USERNAME=
MAIL_PASSWORD=
# Local SePay payment verification. Keep API tokens server-side and out of Git.
SPRING_PROFILES_ACTIVE=local
SEPAY_ENABLED=false
SEPAY_API_TOKEN=
SEPAY_BANK_NAME=
SEPAY_BANK_ACCOUNT=
SEPAY_ACCOUNT_HOLDER=
SEPAY_PAYMENT_MODE=POLLING
SEPAY_POLL_INTERVAL_MS=5000
SEPAY_DEMO_ENABLED=false
# Public website URL used by the "Xem chi tiết đặt bàn" email button.
PUBLIC_BASE_URL=http://localhost:8085
DEPOSIT_PAYMENT_MINUTES=120
DEPOSIT_REVIEW_MINUTES=120
DEPOSIT_FULL_REFUND_NOTICE_MINUTES=1440
DEPOSIT_LATE_REFUND_PERCENT=50
DEPOSIT_NO_SHOW_REFUND_PERCENT=0
SERVER_PORT=8085
CLOUDINARY_URL=
